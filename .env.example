# Copy to .env and fill in. Never commit real values.

# --- Server ---
PORT=3000
# HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy (nginx, load balancer)
# TRUST_PROXY=1

# --- Sessions (required in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Password for the admin account when a brand-new database is created
# ADMIN_INITIAL_PASSWORD=

# --- AI (optional: built-in responses are used when unset) ---
GEMINI_API_KEY=

# --- Court registries ---
ECOURT_API_BASE_URL=https://webapi.ecourtsindia.com
ECOURT_API_KEY=eci_live_rx8jktnz9mckigsikdpgqa4ho0yvfd1u
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org
INDIAN_KANOON_API_TOKEN=

# --- Persistence (optional mirrors; data/db.json is always written) ---
MONGODB_URL=
MONGODB_DB_NAME=spring_inventory
# Supabase: either a direct Postgres string or URL + service key
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# --- Email (optional: without SMTP, emails are recorded in the outbox only) ---
ALERT_EMAIL_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- PDF rendering (optional) ---
# Path to an installed Chrome/Edge; defaults to the browser Puppeteer downloads
# PDF_BROWSER_PATH=
